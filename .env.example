# The Movie Database (TMDB) API Key
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Default target region for streaming provider availability (e.g., BD for Bangladesh, US for USA)
TMDB_DEFAULT_REGION=BD

# Optional: App Site Password Gate (for protecting personal data if deployed publicly)
APP_ACCESS_CODE=
